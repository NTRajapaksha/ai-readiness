# -----------------------------------------------------------------------------
# Tai Labs AI Readiness Assessment Tool — Environment Variables Configuration
# -----------------------------------------------------------------------------
# Note: The app works 100% out-of-the-box using the Smart Interpretation Engine even without API keys.
# Add any of the optional keys below to enable live LLM provider calls.

# OpenAI (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=

# Anthropic (Claude 3.5 Sonnet / Claude 3 Haiku)
ANTHROPIC_API_KEY=

# Google Gemini (Gemini 1.5 Flash / Pro)
GEMINI_API_KEY=

# Groq (Llama 3.3 70B)
GROQ_API_KEY=

# Custom / Local LLM Endpoint (e.g. Ollama, OpenRouter, LM Studio)
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
